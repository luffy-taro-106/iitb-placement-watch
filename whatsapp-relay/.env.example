# All values are private Render environment variables, never browser JS or URLs.
# Copy the exact SESSION pooler host from Supabase Connect, port 5432.
DATABASE_URL=postgresql://placement_wa.PROJECT_REF:PRIVATE_PASSWORD@EXACT_SESSION_POOLER_HOST:5432/postgres?sslmode=verify-full
ADMIN_TOKEN=64_lowercase_hex_characters_from_32_random_bytes
RELAY_SECRET=a_different_64_lowercase_hex_secret
PUBLIC_ORIGIN=https://YOUR_SERVICE.onrender.com
PORT=8080
